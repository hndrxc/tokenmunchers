{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/integrations/plugin/src/cli.ts\" hook --source codex",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/integrations/plugin/src/cli.ts\" hook --source codex",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
